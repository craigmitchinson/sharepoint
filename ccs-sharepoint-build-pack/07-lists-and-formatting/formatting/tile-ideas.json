{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 160,
  "width": 290,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "height": "100%",
      "box-sizing": "border-box",
      "background-color": "#FFFFFF",
      "border": "1px solid #EDEBE9",
      "border-radius": "6px",
      "overflow": "hidden",
      "padding": "14px",
      "gap": "8px"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "justify-content": "space-between",
          "gap": "8px",
          "align-items": "center"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Theme]",
            "style": {
              "display": "inline-block",
              "white-space": "nowrap",
              "font-size": "11.5px",
              "padding": "1px 7px",
              "border-radius": "999px",
              "border": "1px solid #D3C3EE",
              "color": "#4F2391"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$IdeaStatus]",
            "style": {
              "display": "=if([$IdeaStatus] == '', 'none', 'inline-block')",
              "white-space": "nowrap",
              "padding": "2px 8px",
              "border-radius": "2px",
              "font-size": "12px",
              "font-weight": "600",
              "line-height": "18px",
              "background-color": "=if([$IdeaStatus] == 'Chosen', '#4F2391', if([$IdeaStatus] == 'Shortlisted', '#EDE6F7', if([$IdeaStatus] == 'New', '#F3F2F1', if([$IdeaStatus] == 'Parked', '#F3F2F1', '#F3F2F1'))))",
              "color": "=if([$IdeaStatus] == 'Chosen', '#FFFFFF', if([$IdeaStatus] == 'Shortlisted', '#4F2391', if([$IdeaStatus] == 'New', '#323130', if([$IdeaStatus] == 'Parked', '#605E5C', '#323130'))))"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Title]",
        "style": {
          "font-size": "15px",
          "font-weight": "600",
          "color": "#252423",
          "line-height": "1.3"
        }
      },
      {
        "elmType": "div",
        "style": {
          "margin-top": "auto",
          "display": "flex",
          "justify-content": "space-between",
          "align-items": "center",
          "font-size": "12px",
          "color": "#605E5C"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$BusinessArea]"
          },
          {
            "elmType": "div",
            "style": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "4px",
              "color": "#4F2391",
              "font-weight": "600"
            },
            "children": [
              {
                "elmType": "span",
                "style": {
                  "font-size": "12px"
                },
                "attributes": {
                  "iconName": "Like"
                }
              },
              {
                "elmType": "span",
                "txtContent": "=if([$LikesCount] == '', '0', [$LikesCount])"
              }
            ]
          }
        ]
      }
    ]
  }
}