{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 200,
  "width": 372,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "height": "100%",
      "box-sizing": "border-box",
      "padding": "18px",
      "background-color": "#FFFFFF",
      "border": "1px solid #E1DFDD",
      "border-radius": "4px",
      "box-shadow": "0 1.6px 3.6px rgba(0,0,0,0.13), 0 0.3px 0.9px rgba(0,0,0,0.11)",
      "overflow": "hidden",
      "cursor": "default"
    },
    "children": [
      {
        "elmType": "div",
        "txtContent": "[$Quote]",
        "style": {
          "font-size": "17px",
          "color": "#252423",
          "line-height": "1.45"
        }
      },
      {
        "elmType": "div",
        "style": {
          "margin-top": "auto",
          "padding-top": "12px",
          "border-top": "1px solid #EDEBE9"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "style": {
              "font-size": "14px",
              "font-weight": "600",
              "color": "#323130"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Role]",
            "style": {
              "font-size": "12px",
              "color": "#605E5C"
            }
          }
        ]
      }
    ]
  }
}
