{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 230,
  "width": 380,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "height": "100%",
      "box-sizing": "border-box",
      "background-color": "#FFFFFF",
      "border": "1px solid #E1DFDD",
      "border-radius": "6px",
      "overflow": "hidden",
      "padding": "20px",
      "gap": "12px"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "center",
          "gap": "12px"
        },
        "children": [
          {
            "elmType": "img",
            "style": {
              "width": "40px",
              "height": "40px",
              "flex": "0 0 40px"
            },
            "attributes": {
              "src": "[$TeamMark]",
              "alt": ""
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "style": {
              "font-size": "18px",
              "font-weight": "600",
              "color": "#252423"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Description]",
        "style": {
          "font-size": "14px",
          "line-height": "1.55",
          "color": "#323130",
          "min-height": "66px"
        }
      },
      {
        "elmType": "div",
        "style": {
          "margin-top": "auto",
          "padding-top": "10px",
          "border-top": "1px solid #EDEBE9",
          "display": "flex",
          "justify-content": "space-between",
          "font-size": "13px"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "=[$People] + ' people'",
            "style": {
              "color": "#605E5C"
            }
          },
          {
            "elmType": "a",
            "txtContent": "Go to the team site",
            "attributes": {
              "href": "[$TeamSite]",
              "target": "_blank",
              "class": "ms-fontColor-themePrimary"
            },
            "style": {
              "font-weight": "600",
              "text-decoration": "none"
            }
          }
        ]
      }
    ]
  }
}