{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 96,
  "width": 380,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "height": "100%",
      "box-sizing": "border-box",
      "background-color": "#FFFFFF",
      "border": "1px solid #E1DFDD",
      "border-radius": "6px",
      "overflow": "hidden",
      "padding": "14px 16px"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "center",
          "gap": "10px"
        },
        "children": [
          {
            "elmType": "img",
            "style": {
              "width": "28px",
              "height": "28px",
              "flex": "0 0 28px"
            },
            "attributes": {
              "src": "[$TeamMark]",
              "alt": ""
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "style": {
              "font-size": "15px",
              "font-weight": "600",
              "color": "#252423"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Description]",
        "style": {
          "font-size": "13px",
          "line-height": "1.5",
          "color": "#323130",
          "margin-top": "6px"
        }
      }
    ]
  }
}