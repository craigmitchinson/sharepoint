{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "=if(@currentField == '', 'none', 'inline-block')",
    "white-space": "nowrap",
    "padding": "2px 8px",
    "border-radius": "2px",
    "font-size": "12px",
    "font-weight": "600",
    "line-height": "18px",
    "background-color": "=if(@currentField == 'Explore', '#EDE6F7', if(@currentField == 'Test', '#DDE3EF', if(@currentField == 'Decide', '#F5EAD1', if(@currentField == 'Handed over', '#E3F1DF', if(@currentField == 'Stopped', '#F3F2F1', '#EDEBE9')))))",
    "color": "=if(@currentField == 'Explore', '#4F2391', if(@currentField == 'Test', '#273860', if(@currentField == 'Decide', '#754F00', if(@currentField == 'Handed over', '#39682E', if(@currentField == 'Stopped', '#605E5C', '#323130')))))"
  },
  "txtContent": "@currentField"
}