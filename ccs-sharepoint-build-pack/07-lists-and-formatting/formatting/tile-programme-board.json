{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/board-formatting.schema.json",
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "6px",
      "padding": "10px 12px",
      "width": "100%",
      "box-sizing": "border-box"
    },
    "children": [
      {
        "elmType": "div",
        "txtContent": "[$Title]",
        "style": {
          "font-size": "14px",
          "font-weight": "600",
          "color": "#252423",
          "line-height": "1.3"
        }
      },
      {
        "elmType": "div",
        "txtContent": "[$Description]",
        "style": {
          "font-size": "12.5px",
          "line-height": "1.45",
          "color": "#323130"
        }
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "justify-content": "space-between",
          "align-items": "center",
          "gap": "8px"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Team]",
            "style": {
              "font-size": "12px",
              "color": "#605E5C"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$State]",
            "style": {
              "display": "=if([$State] == '', 'none', 'inline-block')",
              "white-space": "nowrap",
              "padding": "2px 8px",
              "border-radius": "2px",
              "font-size": "12px",
              "font-weight": "600",
              "line-height": "18px",
              "background-color": "=if([$State] == 'Building', '#F5EAD1', if([$State] == 'Assessing', '#FFFFFF', ''))",
              "color": "=if([$State] == 'Building', '#754F00', if([$State] == 'Assessing', '#605E5C', ''))",
              "border": "=if([$State] == 'Assessing', '1px dashed #8A8886', 'none')"
            },
            "attributes": {
              "class": "=if([$State] == 'Working', 'ms-bgColor-themePrimary ms-fontColor-white', '')"
            }
          }
        ]
      }
    ]
  }
}