{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 300,
  "width": 372,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "width": "100%",
      "height": "100%",
      "box-sizing": "border-box",
      "padding": "18px",
      "background-color": "#FFFFFF",
      "border": "1px solid #E1DFDD",
      "border-radius": "4px",
      "box-shadow": "0 1.6px 3.6px rgba(0,0,0,0.13), 0 0.3px 0.9px rgba(0,0,0,0.11)",
      "overflow": "hidden",
      "cursor": "default"
    },
    "children": [
      {
        "elmType": "div",
        "txtContent": "[$BusinessArea]",
        "style": {
          "align-self": "flex-start",
          "font-size": "12px",
          "font-weight": "600",
          "padding": "2px 8px",
          "background-color": "#F6D5DC",
          "color": "#A11030",
          "border-radius": "2px"
        }
      },
      {
        "elmType": "div",
        "txtContent": "[$Title]",
        "style": {
          "font-size": "20px",
          "font-weight": "600",
          "color": "#252423",
          "margin-top": "10px"
        }
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "margin-top": "12px"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "flex": "1",
              "padding": "12px",
              "background-color": "#F3F2F1",
              "margin-right": "10px"
            },
            "children": [
              {
                "elmType": "div",
                "txtContent": "Before",
                "style": {
                  "font-size": "12px",
                  "color": "#605E5C"
                }
              },
              {
                "elmType": "div",
                "txtContent": "[$Before]",
                "style": {
                  "font-size": "22px",
                  "font-weight": "600",
                  "color": "#252423"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "flex": "1",
              "padding": "12px",
              "background-color": "#CE143D"
            },
            "children": [
              {
                "elmType": "div",
                "txtContent": "After",
                "style": {
                  "font-size": "12px",
                  "color": "#F6D5DC"
                }
              },
              {
                "elmType": "div",
                "txtContent": "[$After]",
                "style": {
                  "font-size": "22px",
                  "font-weight": "600",
                  "color": "#FFFFFF"
                }
              }
            ]
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Quote]",
        "style": {
          "font-size": "14px",
          "color": "#605E5C",
          "font-style": "italic",
          "line-height": "1.5",
          "margin-top": "12px"
        }
      }
    ]
  }
}
