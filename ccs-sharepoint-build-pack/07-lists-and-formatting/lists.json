    {
      "name": "Programme",
      "site": "Lab",
      "gallery": "tile-labitems.json",
      "fields": [
        {
          "name": "Description",
          "type": "Note"
        },
        {
          "name": "Stage",
          "type": "Choice",
          "choices": [
            "Sense",
            "Understand",
            "Act",
            "Prove"
          ]
        },
        {
          "name": "State",
          "type": "Choice",
          "choices": [
            "Working",
            "Building",
            "Assessing"
          ],
