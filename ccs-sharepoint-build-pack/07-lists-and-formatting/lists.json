        {
          "name": "SortOrder",
          "type": "Number"
        }
      ],
      "views": [
        {
          "title": "Board",
          "layout": "Board, grouped by Stage (bucket order Sense, Understand, Act, Prove)",
          "fields": [
            "Title",
            "Description",
            "Team",
            "State"
          ],
          "note": "Create in the browser: + Add view, Board, group by Stage. Then Format current view, Advanced mode, paste tile-programme-board.json"
        },
        {
          "title": "Cards",
          "layout": "Gallery",
          "fields": [
            "Title",
            "Description",
            "State"
          ],
          "note": "Dark cards used on the team business site's Our Lab work page (tile-labitems.json)"
        }
      ],
      "note": "One per Lab hub (/sites/ccs-{lab}/Lists/Programme). State 'Working' takes the site theme colour.",
      "board": "tile-programme-board.json"
    },
    {
      "name": "Solutions",
      "site": "Platform",
      "fields": [
        {
          "name": "Lab",
          "type": "Choice",
          "choices": [
            "24x7 Services",
            "Automated Operations",
            "Colleague Tooling",
            "Data & Insights"
          ]
        },
        {
          "name": "Team",
          "type": "Text",
          "note": "Team name as it appears in the hub navigation, e.g. Automated Services"
        },
        {
          "name": "SolutionType",
          "type": "Choice",
          "choices": [
            "Digital worker",
            "App",
            "Agent",
            "Service",
            "Report",
            "Site"
          ],
          "format": "col-solutiontype.json"
        },
        {
          "name": "BusinessArea",
          "type": "Choice",
          "choices": [
            "Insurance",
            "Pensions",
            "Investments",
            "Shared services"
          ]
        },
        {
          "name": "Squad",
          "type": "Choice",
          "choices": [
            "Service",
            "Squad 1",
            "Squad 2",
            "Squad 3",
            "Squad 4"
          ]
        },
        {
          "name": "Status",
          "type": "Choice",
          "choices": [
            "Live",
            "In build",
            "Retired"
          ]
        },
        {
          "name": "Owner",
          "type": "User"
        },
        {
          "name": "HeroJourney",
          "display": "Hero journey",
          "type": "Choice",
          "choices": [
            "Make a claim",
            "Change a policy",
            "Transfer a pension",
            "Take retirement income",
            "Keep my details up to date",
            "Report a death",
            "Make a complaint",
            "None"
          ]
        },
        {
          "name": "CasesThisYear",
          "display": "Cases this year",
          "type": "Number"
        },
        {
          "name": "ValueThisYear",
          "display": "Value this year",
          "type": "Currency"
        },
        {
          "name": "SolutionPage",
          "display": "Solution page",
          "type": "URL"
        },
        {
          "name": "ReviewBy",
          "display": "Review by",
          "type": "DateTime"
        }
      ],
      "views": [
        {
          "title": "Live in Insurance",
          "fields": [
            "Title",
            "SolutionType"
          ],
          "query": "<Where><And><Eq><FieldRef Name='BusinessArea'/><Value Type='Choice'>Insurance</Value></Eq><Eq><FieldRef Name='Status'/><Value Type='Choice'>Live</Value></Eq></And></Where><OrderBy><FieldRef Name='Title'/></OrderBy>",
          "note": "Team sites filter this view by Lab and Team in the List web part"
        },
        {
          "title": "Live in Pensions",
          "fields": [
            "Title",
            "SolutionType"
          ],
          "query": "<Where><And><Eq><FieldRef Name='BusinessArea'/><Value Type='Choice'>Pensions</Value></Eq><Eq><FieldRef Name='Status'/><Value Type='Choice'>Live</Value></Eq></And></Where><OrderBy><FieldRef Name='Title'/></OrderBy>",
          "note": "Team sites filter this view by Lab and Team in the List web part"
        },
        {
          "title": "Live in Investments",
          "fields": [
            "Title",
            "SolutionType"
          ],
          "query": "<Where><And><Eq><FieldRef Name='BusinessArea'/><Value Type='Choice'>Investments</Value></Eq><Eq><FieldRef Name='Status'/><Value Type='Choice'>Live</Value></Eq></And></Where><OrderBy><FieldRef Name='Title'/></OrderBy>",
          "note": "Team sites filter this view by Lab and Team in the List web part"
        },
        {
          "title": "All live",
          "fields": [
            "Title",
            "SolutionType",
            "BusinessArea",
            "Squad",
            "Owner"
          ],
          "query": "<Where><Eq><FieldRef Name='Status'/><Value Type='Choice'>Live</Value></Eq></Where><OrderBy><FieldRef Name='BusinessArea'/><FieldRef Name='Title'/></OrderBy>",
          "note": "Team sites filter this view by Lab and Team in the List web part"
        }
      ]
    },
    {
      "name": "Requests",
      "site": "Platform",
      "titleLabel": "Request",
      "readOwnItemsOnly": true,
      "formHeader": "form-requests.json",
      "fields": [
        {
          "name": "Lab",
          "type": "Choice",
          "choices": [
            "24x7 Services",
            "Automated Operations",
            "Colleague Tooling",
            "Data & Insights"
          ]
        },
        {
          "name": "Team",
          "type": "Text",
          "note": "Team name as it appears in the hub navigation, e.g. Automated Services"
        },
        {
          "name": "IASolution",
          "display": "Solution",
          "type": "Lookup",
          "lookupList": "Solutions"
        },
        {
          "name": "IADetails",
          "display": "Details",
          "type": "Note"
        },
        {
          "name": "IAWhatHappened",
          "display": "What happened",
          "type": "Note"
        },
        {
          "name": "IAImpact",
          "display": "Impact",
          "type": "Choice",
          "choices": [
            "Stopping work",
            "Slowing work",
            "Minor"
          ]
        },
        {
          "name": "IAStarted",
          "display": "When it started",
          "type": "DateTime"
        },
        {
          "name": "IAChangeType",
          "display": "Change type",
          "type": "Choice",
          "choices": [
            "Change what it does",
            "Change when it runs",
            "A system it uses is changing"
          ]
        },
        {
          "name": "IASystemChangeDate",
          "display": "When the system changes",
          "type": "DateTime"
        },
        {
          "name": "IABusinessArea",
          "display": "Business area",
          "type": "Choice",
          "choices": [
            "Insurance",
            "Pensions",
            "Investments",
            "Shared services"
          ]
        },
        {
          "name": "IAMonthlyVolume",
          "display": "Cases a month",
          "type": "Number"
        },
        {
          "name": "IAMinutesPerCase",
          "display": "Minutes per case by hand",
          "type": "Number"
        },
        {
          "name": "IAPain",
          "display": "What hurts most",
          "type": "Note"
        },
        {
          "name": "IAStatus",
          "display": "Status",
          "type": "Choice",
          "choices": [
            "New",
            "With us",
            "In progress",
            "Done",
            "Not a fit"
          ],
          "format": "col-requeststatus.json",
          "internalOnly": true
        },
        {
          "name": "IASquad",
          "display": "Squad",
          "type": "Choice",
          "choices": [
            "Service",
            "Squad 1",
            "Squad 2",
            "Squad 3",
            "Squad 4"
          ],
          "internalOnly": true
        },
        {
          "name": "IAGate",
          "display": "Gate",
          "type": "Choice",
          "choices": [
            "Qualified",
            "Viable",
            "Ready to build",
            "Ready to test",
            "Ready to release",
            "Sustained"
          ],
          "format": "col-gate.json",
          "internalOnly": true
        },
        {
          "name": "IAWaiting",
          "display": "Waiting",
          "type": "Text",
          "format": "col-waiting.json",
          "internalOnly": true
        }
      ],
      "contentTypes": [
        {
          "name": "Question",
          "fields": [
            "IASolution",
            "IADetails"
          ]
        },
        {
          "name": "Problem",
          "fields": [
            "IASolution",
            "IAWhatHappened",
            "IAImpact",
            "IAStarted"
          ]
        },
        {
          "name": "Change",
          "fields": [
            "IASolution",
            "IAChangeType",
            "IASystemChangeDate",
            "IADetails"
          ]
        },
        {
          "name": "New idea",
          "fields": [
            "IABusinessArea",
            "IAMonthlyVolume",
            "IAMinutesPerCase",
            "IAPain"
          ]
        }
      ],
      "views": [
        {
          "title": "My requests",
          "fields": [
            "Title",
            "ContentType",
            "IASolution",
            "IAStatus",
            "Created"
          ],
          "query": "<Where><Eq><FieldRef Name='Author'/><Value Type='Integer'><UserID Type='Integer'/></Value></Eq></Where><OrderBy><FieldRef Name='Created' Ascending='FALSE'/></OrderBy>"
        },
        {
          "title": "Triage",
          "fields": [
            "Title",
            "IASolution",
            "IAStatus",
            "IASquad",
            "IAGate",
            "IAWaiting",
            "Author"
          ],
          "query": "<GroupBy Collapse='FALSE' GroupLimit='100'><FieldRef Name='ContentType'/></GroupBy><Where><And><Neq><FieldRef Name='IAStatus'/><Value Type='Choice'>Done</Value></Neq><Neq><FieldRef Name='IAStatus'/><Value Type='Choice'>Not a fit</Value></Neq></And></Where><OrderBy><FieldRef Name='Created'/></OrderBy>"
        }
      ]
    },
