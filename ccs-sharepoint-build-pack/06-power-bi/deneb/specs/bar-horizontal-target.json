{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bars on a light track with value labels and an optional target rule (e.g. cost per case against by hand). Fields: Category, Amount, Label (formatted text), Target (optional). TargetLabel: formatted target, e.g. \u00a34.80.",
  "data": {
    "name": "dataset"
  },
  "title": {
    "text": "Cost per case",
    "subtitle": "Automated, against the same case done by hand"
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 12,
        "labelColor": "#3B3A39",
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#F3F2F1",
        "cornerRadiusEnd": 9,
        "height": 18
      },
      "encoding": {
        "x": {
          "aggregate": "max",
          "field": "Track",
          "type": "quantitative",
          "axis": null,
          "title": null
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 9,
        "height": 18,
        "color": "#CE143D"
      },
      "encoding": {
        "x": {
          "field": "Amount",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Category"
          },
          {
            "field": "Label"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": 600,
        "color": "#15223E"
      },
      "encoding": {
        "x": {
          "aggregate": "max",
          "field": "Track",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#15223E",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Target",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": "height"
        }
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "Target",
              "as": "Target"
            }
          ]
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "Target",
              "as": "Target"
            },
            {
              "op": "max",
              "field": "TargetLabel",
              "as": "TargetLabel"
            }
          ]
        },
        {
          "calculate": "'By hand ' + datum.TargetLabel",
          "as": "tl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -4,
        "dy": -6,
        "fontSize": 11,
        "fontWeight": 400,
        "color": "#605E5C"
      },
      "encoding": {
        "x": {
          "field": "Target",
          "type": "quantitative"
        },
        "y": {
          "value": -4
        },
        "text": {
          "field": "tl"
        }
      }
    }
  ],
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Amount",
          "as": "m"
        },
        {
          "op": "max",
          "field": "Target",
          "as": "t"
        }
      ]
    },
    {
      "calculate": "max(datum.m, datum.t || 0) * 1.08",
      "as": "Track"
    }
  ]
}