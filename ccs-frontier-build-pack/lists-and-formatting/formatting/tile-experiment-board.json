{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/board-formatting.schema.json",
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "7px",
      "padding": "10px 12px",
      "width": "100%",
      "box-sizing": "border-box"
    },
    "children": [
      {
        "elmType": "a",
        "txtContent": "[$Title]",
        "style": {
          "font-size": "14px",
          "font-weight": "600",
          "color": "#252423",
          "line-height": "1.3",
          "text-decoration": "none"
        },
        "attributes": {
          "href": "[$ExperimentPage]",
          "target": "_top",
          "data-interception": "off"
        }
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "flex-wrap": "wrap",
          "gap": "4px"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Outcome]",
            "style": {
              "display": "inline-block",
              "white-space": "nowrap",
              "font-size": "11.5px",
              "padding": "1px 8px",
              "border-radius": "999px",
              "border": "1px solid #D3C3EE",
              "color": "#4F2391",
              "font-weight": "600",
              "background-color": "#F7F4FC"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "justify-content": "space-between",
          "align-items": "center",
          "gap": "8px"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "=[$Technology] + ' \u00b7 ' + if([$Stage] == 'Handed over', 'to ' + [$HandedTo], [$SponsorArea])",
            "style": {
              "font-size": "12px",
              "color": "#605E5C",
              "line-height": "1.4"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Stage]",
            "style": {
              "display": "=if([$Stage] == '', 'none', 'inline-block')",
              "white-space": "nowrap",
              "padding": "2px 8px",
              "border-radius": "2px",
              "font-size": "12px",
              "font-weight": "600",
              "line-height": "18px",
              "background-color": "=if([$Stage] == 'Explore', '#EDE6F7', if([$Stage] == 'Test', '#DDE3EF', if([$Stage] == 'Decide', '#F5EAD1', if([$Stage] == 'Handed over', '#E3F1DF', if([$Stage] == 'Stopped', '#F3F2F1', '#F3F2F1')))))",
              "color": "=if([$Stage] == 'Explore', '#4F2391', if([$Stage] == 'Test', '#273860', if([$Stage] == 'Decide', '#754F00', if([$Stage] == 'Handed over', '#39682E', if([$Stage] == 'Stopped', '#605E5C', '#323130')))))"
            }
          }
        ]
      }
    ]
  }
}