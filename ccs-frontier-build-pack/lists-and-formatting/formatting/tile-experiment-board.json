{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/board-formatting.schema.json",
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "block",
      "width": "100%",
      "min-height": "110px",
      "box-sizing": "border-box",
      "padding": "12px 14px",
      "background-color": "#FFFFFF",
      "border-radius": "4px"
    },
    "children": [
      {
        "elmType": "a",
        "txtContent": "[$Title]",
        "attributes": {
          "href": "[$ExperimentPage]",
          "target": "_top",
          "data-interception": "off"
        },
        "style": {
          "display": "block",
          "font-size": "14px",
          "font-weight": "600",
          "color": "#252423",
          "line-height": "1.3",
          "text-decoration": "none",
          "white-space": "normal"
        }
      },
      {
        "elmType": "div",
        "txtContent": "[$Outcome]",
        "style": {
          "display": "=if([$Outcome] == '', 'none', 'inline-block')",
          "margin-top": "8px",
          "white-space": "nowrap",
          "font-size": "11.5px",
          "padding": "1px 8px",
          "border-radius": "999px",
          "border": "1px solid #D3C3EE",
          "color": "#4F2391",
          "font-weight": "600",
          "background-color": "#F7F4FC"
        }
      },
      {
        "elmType": "div",
        "txtContent": "=[$Technology] + ' · ' + if([$Stage] == 'Handed over', 'to ' + [$HandedTo], [$SponsorArea])",
        "style": {
          "display": "block",
          "margin-top": "8px",
          "font-size": "12px",
          "color": "#605E5C",
          "line-height": "1.4",
          "white-space": "normal"
        }
      },
      {
        "elmType": "div",
        "txtContent": "[$Stage]",
        "style": {
          "display": "=if([$Stage] == '', 'none', 'inline-block')",
          "margin-top": "8px",
          "white-space": "nowrap",
          "padding": "2px 8px",
          "border-radius": "2px",
          "font-size": "12px",
          "font-weight": "600",
          "line-height": "18px",
          "background-color": "=if([$Stage] == 'Explore', '#EDE6F7', if([$Stage] == 'Test', '#DDE3EF', if([$Stage] == 'Decide', '#F5EAD1', if([$Stage] == 'Handed over', '#E3F1DF', '#F3F2F1'))))",
          "color": "=if([$Stage] == 'Explore', '#4F2391', if([$Stage] == 'Test', '#273860', if([$Stage] == 'Decide', '#754F00', if([$Stage] == 'Handed over', '#39682E', '#605E5C'))))"
        }
      }
    ]
  }
}