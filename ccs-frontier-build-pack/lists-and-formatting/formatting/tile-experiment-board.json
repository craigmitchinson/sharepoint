{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/board-formatting.schema.json",
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "block",
      "width": "100%",
      "box-sizing": "border-box",
      "text-align": "left",
      "align-self": "stretch"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "block",
          "box-sizing": "border-box",
          "width": "100%",
          "padding": "10px 12px",
          "background-color": "#FFFFFF",
          "border-radius": "4px",
          "box-shadow": "0 1px 2px rgba(0,0,0,.12)",
          "text-align": "left"
        },
        "children": [
          {
            "elmType": "a",
            "txtContent": "[$Title]",
            "attributes": {
              "href": "[$ExperimentPage]",
              "target": "_top",
              "data-interception": "off"
            },
            "style": {
              "display": "block",
              "font-size": "14px",
              "font-weight": "600",
              "color": "#252423",
              "line-height": "1.3",
              "text-decoration": "none",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "txtContent": "=if([$HandedTo] == '', [$SponsorArea], 'Handed to ' + [$HandedTo])",
            "style": {
              "display": "=if([$SponsorArea] == '' && [$HandedTo] == '', 'none', 'block')",
              "margin-top": "4px",
              "font-size": "12.5px",
              "font-weight": "600",
              "color": "#4F2391",
              "line-height": "1.4",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Summary]",
            "style": {
              "display": "=if([$Summary] == '', 'none', 'block')",
              "margin-top": "6px",
              "font-size": "12.5px",
              "color": "#323130",
              "line-height": "1.45",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "block",
              "margin-top": "8px",
              "text-align": "left"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "[$Outcome]",
                "style": {
                  "display": "=if([$Outcome] == '', 'none', 'inline-block')",
                  "white-space": "nowrap",
                  "font-size": "11.5px",
                  "font-weight": "600",
                  "padding": "1px 8px",
                  "border-radius": "999px",
                  "border": "1px solid #D3C3EE",
                  "color": "#4F2391",
                  "background-color": "#F7F4FC",
                  "margin-right": "6px"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$Technology]",
                "style": {
                  "display": "=if([$Technology] == '', 'none', 'inline-block')",
                  "font-size": "12px",
                  "color": "#605E5C",
                  "line-height": "1.4"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}