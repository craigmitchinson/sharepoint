{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/board-formatting.schema.json",
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "block",
      "width": "100%",
      "box-sizing": "border-box",
      "text-align": "left",
      "align-self": "stretch"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "block",
          "box-sizing": "border-box",
          "width": "100%",
          "padding": "12px 14px",
          "background-color": "#FFFFFF",
          "border": "1px solid #E1DFDD",
          "border-radius": "4px",
          "text-align": "left"
        },
        "children": [
          {
            "elmType": "a",
            "txtContent": "[$Title]",
            "attributes": {
              "href": "[$ExperimentPage]",
              "target": "_top",
              "data-interception": "off"
            },
            "style": {
              "display": "block",
              "font-size": "14px",
              "font-weight": "600",
              "color": "#252423",
              "line-height": "1.3",
              "text-decoration": "none",
              "white-space": "normal",
              "text-align": "left"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Outcome]",
            "style": {
              "display": "=if([$Outcome] == '', 'none', 'inline-block')",
              "margin-top": "8px",
              "white-space": "nowrap",
              "font-size": "11.5px",
              "padding": "1px 8px",
              "border-radius": "999px",
              "border": "1px solid #D3C3EE",
              "color": "#4F2391",
              "font-weight": "600",
              "background-color": "#F7F4FC"
            }
          },
          {
            "elmType": "div",
            "txtContent": "=if([$Technology] == '', '', [$Technology] + ' · ') + if([$Stage] == 'Handed over', 'to ' + [$HandedTo], [$SponsorArea])",
            "style": {
              "display": "block",
              "margin-top": "8px",
              "font-size": "12px",
              "color": "#605E5C",
              "line-height": "1.4",
              "white-space": "normal",
              "text-align": "left"
            }
          }
        ]
      }
    ]
  }
}