{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "display": "block",
      "width": "100%",
      "box-sizing": "border-box",
      "padding": "5px 2px",
      "text-align": "left"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "block",
          "box-sizing": "border-box",
          "width": "100%",
          "padding": "14px 16px 12px",
          "background-color": "#FFFFFF",
          "border-radius": "6px",
          "box-shadow": "0 1px 2px rgba(30,13,61,.06)",
          "text-align": "left",
          "border": "1px solid #E1DFDD",
          "border-left-width": "4px",
          "border-left-style": "solid",
          "border-left-color": "=if([$board_x0020_choice] == 'Explore', '#7A4CC4', if([$board_x0020_choice] == 'Test', '#3A5BA0', if([$board_x0020_choice] == 'Decide', '#B07D10', if([$board_x0020_choice] == 'Handed over', '#4A8A3B', '#8A8886'))))"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "=if([$HandedTo] == '', [$SponsorArea], 'Handed to ' + [$HandedTo])",
            "style": {
              "display": "=if([$SponsorArea] == '' && [$HandedTo] == '', 'none', 'block')",
              "font-size": "11px",
              "font-weight": "700",
              "letter-spacing": ".06em",
              "text-transform": "uppercase",
              "color": "=if([$board_x0020_choice] == 'Explore', '#7A4CC4', if([$board_x0020_choice] == 'Test', '#3A5BA0', if([$board_x0020_choice] == 'Decide', '#B07D10', if([$board_x0020_choice] == 'Handed over', '#4A8A3B', '#8A8886'))))",
              "line-height": "1.3",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "a",
            "txtContent": "[$Title]",
            "attributes": {
              "href": "[$ExperimentPage]",
              "target": "_top",
              "data-interception": "off"
            },
            "style": {
              "display": "block",
              "margin-top": "4px",
              "font-size": "15px",
              "font-weight": "600",
              "color": "#1E0D3D",
              "line-height": "1.3",
              "text-decoration": "none",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Summary]",
            "style": {
              "display": "=if([$Summary] == '', 'none', 'block')",
              "margin-top": "6px",
              "font-size": "13px",
              "color": "#484644",
              "line-height": "1.45",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "block",
              "margin-top": "10px",
              "padding-top": "10px",
              "border-top": "1px solid #F3F2F1",
              "text-align": "left"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "[$Outcome]",
                "style": {
                  "display": "=if([$Outcome] == '', 'none', 'inline-block')",
                  "white-space": "nowrap",
                  "font-size": "11.5px",
                  "font-weight": "600",
                  "padding": "2px 9px",
                  "border-radius": "999px",
                  "background-color": "=if([$Outcome] == 'Better service', '#F1EBFA', if([$Outcome] == 'Faster', '#E5ECF8', if([$Outcome] == 'Lower risk', '#FBF1DC', if([$Outcome] == 'Evidence', '#E6F2E2', '#F3F2F1'))))",
                  "color": "=if([$Outcome] == 'Better service', '#4F2391', if([$Outcome] == 'Faster', '#273860', if([$Outcome] == 'Lower risk', '#754F00', if([$Outcome] == 'Evidence', '#39682E', '#605E5C'))))",
                  "margin": "0 6px 4px 0"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$Technology]",
                "style": {
                  "display": "=if([$Technology] == '', 'none', 'inline-block')",
                  "white-space": "nowrap",
                  "font-size": "11.5px",
                  "padding": "2px 9px",
                  "border-radius": "999px",
                  "background-color": "#F3F2F1",
                  "color": "#484644",
                  "margin": "0 6px 4px 0"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}