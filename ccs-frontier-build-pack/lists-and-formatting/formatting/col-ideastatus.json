{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "=if(@currentField == '', 'none', 'inline-block')",
    "white-space": "nowrap",
    "padding": "2px 8px",
    "border-radius": "2px",
    "font-size": "12px",
    "font-weight": "600",
    "line-height": "18px",
    "background-color": "=if(@currentField == 'Chosen', '#4F2391', if(@currentField == 'Shortlisted', '#EDE6F7', if(@currentField == 'New', '#F3F2F1', if(@currentField == 'Parked', '#F3F2F1', '#EDEBE9'))))",
    "color": "=if(@currentField == 'Chosen', '#FFFFFF', if(@currentField == 'Shortlisted', '#4F2391', if(@currentField == 'New', '#323130', if(@currentField == 'Parked', '#605E5C', '#323130'))))"
  },
  "txtContent": "@currentField"
}