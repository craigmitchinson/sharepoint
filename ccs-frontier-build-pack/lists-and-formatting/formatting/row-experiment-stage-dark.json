{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "display": "block",
      "width": "100%",
      "box-sizing": "border-box",
      "padding": "5px 2px",
      "background-color": "transparent",
      "text-align": "left"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "block",
          "box-sizing": "border-box",
          "width": "100%",
          "padding": "14px 16px 12px",
          "background-color": "rgba(255,255,255,.07)",
          "border": "1px solid rgba(255,255,255,.14)",
          "border-left-width": "4px",
          "border-left-style": "solid",
          "border-left-color": "=if([$board_x0020_choice] == 'Explore', '#BBA3EA', if([$board_x0020_choice] == 'Test', '#A9BDE6', if([$board_x0020_choice] == 'Decide', '#F0CF85', if([$board_x0020_choice] == 'Handed over', '#A8D69B', '#C8C6C4'))))",
          "border-radius": "6px",
          "text-align": "left"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "=if([$board_x0020_choice] == 'Handed over' && [$HandedTo] != '', 'Handed to ' + [$HandedTo], [$SponsorArea])",
            "style": {
              "display": "=if([$SponsorArea] == '' && [$board_x0020_choice] != 'Handed over', 'none', 'block')",
              "font-size": "11px",
              "font-weight": "700",
              "letter-spacing": ".06em",
              "text-transform": "uppercase",
              "color": "=if([$board_x0020_choice] == 'Explore', '#BBA3EA', if([$board_x0020_choice] == 'Test', '#A9BDE6', if([$board_x0020_choice] == 'Decide', '#F0CF85', if([$board_x0020_choice] == 'Handed over', '#A8D69B', '#C8C6C4'))))",
              "line-height": "1.3",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "a",
            "txtContent": "[$Title]",
            "attributes": {
              "href": "[$ExperimentPage]",
              "target": "_top",
              "data-interception": "off"
            },
            "style": {
              "display": "block",
              "margin-top": "4px",
              "font-size": "15px",
              "font-weight": "600",
              "color": "#FFFFFF",
              "line-height": "1.3",
              "text-decoration": "none",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Summary]",
            "style": {
              "display": "=if([$Summary] == '', 'none', 'block')",
              "margin-top": "6px",
              "font-size": "13px",
              "color": "rgba(255,255,255,.78)",
              "line-height": "1.45",
              "text-align": "left",
              "white-space": "normal"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "block",
              "margin-top": "10px",
              "padding-top": "10px",
              "border-top": "1px solid rgba(255,255,255,.12)",
              "text-align": "left"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "[$Outcome]",
                "style": {
                  "display": "=if([$Outcome] == '', 'none', 'inline-block')",
                  "white-space": "nowrap",
                  "font-size": "11.5px",
                  "font-weight": "600",
                  "padding": "2px 9px",
                  "border-radius": "999px",
                  "background-color": "=if([$Outcome] == 'Better service', 'rgba(187,163,234,.22)', if([$Outcome] == 'Faster', 'rgba(169,189,230,.22)', if([$Outcome] == 'Lower risk', 'rgba(240,207,133,.22)', if([$Outcome] == 'Evidence', 'rgba(168,214,155,.22)', 'rgba(255,255,255,.12)'))))",
                  "color": "=if([$Outcome] == 'Better service', '#E4D9F7', if([$Outcome] == 'Faster', '#DCE5F6', if([$Outcome] == 'Lower risk', '#F8E6BD', if([$Outcome] == 'Evidence', '#D6EDCF', '#FFFFFF'))))",
                  "margin": "0 6px 4px 0"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$Technology]",
                "style": {
                  "display": "=if([$Technology] == '', 'none', 'inline-block')",
                  "white-space": "nowrap",
                  "font-size": "11.5px",
                  "padding": "2px 9px",
                  "border-radius": "999px",
                  "background-color": "rgba(255,255,255,.10)",
                  "color": "rgba(255,255,255,.85)",
                  "margin": "0 6px 4px 0"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}